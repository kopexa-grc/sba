          "section": "Styles",
          "hidden": true
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        }
      ]
    }
  }
